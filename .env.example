# ---------------------------------------------------------------------------
# Supabase — PUBLIC / browser-safe credentials
# These are exposed to the browser (the VITE_ prefix ships them to the client).
# Safe to expose: the anon/publishable key only allows what Row Level Security
# permits, which for this project is INSERT-only into the signup tables.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix with VITE_, never expose to the browser,
# never commit. Used later by the Resend edge function / server to READ the
# subscriber tables (bypassing RLS) and send emails.
# Find it in: Supabase Dashboard > Project Settings > API > service_role key
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — set up later. Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
